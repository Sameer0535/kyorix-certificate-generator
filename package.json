{
  "name": "kyorix-certificate-generator",
  "version": "0.1.0",
  "description": "Professional Certificate Generator for Kyorix Sports Technology",
  "author": "Kyorix Sports Technology",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "node scratch/qa_suite.js",
    "app:start": "electron .",
    "app:build": "electron-builder --win",
    "app:package": "electron-builder --dir"
  },
  "build": {
    "appId": "com.kyorix.certificategenerator",
    "productName": "Kyorix Certificate Generator",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "electron/**/*",
      "assets/**/*",
      "public/**/*",
      "!**/node_modules/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Kyorix Certificate Generator"
    }
  },
  "dependencies": {
    "@types/jszip": "^3.4.0",
    "clsx": "^2.1.1",
    "html2canvas": "^1.4.1",
    "jspdf": "^2.5.2",
    "jszip": "^3.10.2",
    "lucide-react": "^0.460.0",
    "next": "^14.2.18",
    "pdfjs-dist": "^6.5.438",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3"
  }
}
